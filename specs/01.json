{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 290,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#233F49",
      "titleColor": "#233F49",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "gridColor": "#e6ece9",
      "domain": false,
      "tickColor": "#c8d4d0"
    },
    "legend": {
      "labelColor": "#233F49",
      "titleColor": "#233F49",
      "orient": "bottom",
      "titleFontSize": 11,
      "labelFontSize": 11
    },
    "title": {
      "color": "#233F49"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "data/map_values.json"
            },
            "key": "state",
            "fields": [
              "cultural_share",
              "cultural_visits",
              "abbr"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "cultural_share",
          "type": "quantitative",
          "title": "Cultural visitors (%)",
          "scale": {
            "domain": [
              0,
              0.3
            ],
            "range": [
              "#e3f0e9",
              "#146873"
            ]
          },
          "legend": {
            "format": ".0%",
            "gradientLength": 140
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "title": "State"
          },
          {
            "field": "cultural_share",
            "title": "Cultural share",
            "format": ".1%",
            "type": "quantitative"
          },
          {
            "field": "cultural_visits",
            "title": "Cultural visits",
            "format": ",.0f",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/map_values.json"
      },
      "transform": [
        {
          "filter": "datum.state != 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#233F49"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr",
          "type": "nominal"
        }
      }
    }
  ]
}