{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 320,
  "height": 250,
  "padding": 0,
  "autosize": "fit",
  "data": [
    {
      "name": "tree",
      "values": [
        {
          "id": "All",
          "parent": null
        },
        {
          "id": "Domestic day",
          "parent": "All",
          "value": 1115246519.108555,
          "label": "Day trips",
          "amount": "$1.12b",
          "share": 0.08474461326781603
        },
        {
          "id": "Domestic overnight",
          "parent": "All",
          "value": 5214548832.875121,
          "label": "Domestic\novernight",
          "amount": "$5.21b",
          "share": 0.396239680318724
        },
        {
          "id": "International",
          "parent": "All",
          "value": 6830292069.550395,
          "label": "International",
          "amount": "$6.83b",
          "share": 0.51901570641346
        }
      ],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 3,
          "round": true
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.parent != null"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "International",
        "Domestic overnight",
        "Domestic day"
      ],
      "range": [
        "#24828A",
        "#233F49",
        "#C16742"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "id"
          },
          "tooltip": {
            "signal": "{'Visitor type': datum.id, 'Whole-trip spending': format(datum.value, '$,.0f'), 'Share':format(datum.share, '.1%')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2 + (datum.id == 'Domestic day' ? -5 : -12)"
          },
          "align": {
            "value": "center"
          },
          "fill": {
            "value": "white"
          },
          "fontSize": {
            "value": 11
          },
          "text": {
            "field": "label"
          },
          "lineBreak": {
            "value": "\n"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2 + (datum.id == 'Domestic day' ? 13 : 25)"
          },
          "align": {
            "value": "center"
          },
          "fill": {
            "value": "white"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "text": {
            "field": "amount"
          }
        }
      }
    }
  ]
}