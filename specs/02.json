{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 290,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#233F49",
      "titleColor": "#233F49",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 12,
      "gridColor": "#e6ece9",
      "domain": false,
      "tickColor": "#c8d4d0"
    },
    "legend": {
      "labelColor": "#233F49",
      "titleColor": "#233F49",
      "orient": "bottom",
      "titleFontSize": 11,
      "labelFontSize": 11
    },
    "title": {
      "color": "#233F49"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e7eeea",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/map_values.json"
      },
      "mark": {
        "type": "circle",
        "color": "#C16742",
        "opacity": 0.65,
        "stroke": "white"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "cultural_visits",
          "type": "quantitative",
          "title": "Cultural visits",
          "scale": {
            "domain": [
              0,
              14000000
            ],
            "range": [
              0,
              1800
            ]
          },
          "legend": {
            "values": [
              1000000,
              5000000,
              10000000
            ],
            "format": ".2s"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "cultural_visits",
            "title": "Cultural visits",
            "format": ",.0f",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/map_values.json"
      },
      "mark": {
        "type": "text",
        "dy": -22,
        "fontSize": 10,
        "color": "#233F49"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr",
          "type": "nominal"
        }
      }
    }
  ]
}